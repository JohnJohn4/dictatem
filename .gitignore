*.gguf
models/

# Logs (runtime artefacts, not source)
*.log
logs/

# Local config overrides
*.local.toml

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Claude Code local settings (machine-specific permission allowlists)
.claude/settings.local.json

# IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# PyInstaller (out of scope for v1 but guard early)
*.spec
dist/

